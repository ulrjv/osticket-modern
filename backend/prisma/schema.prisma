// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String   @default("agent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  assignedTickets Ticket[] @relation("AssignedAgent")
  closedTickets   Ticket[] @relation("ClosedByAgent")
}

model Ticket {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  subject      String
  fromName     String
  fromEmail    String
  status       String    // "open", "answered", "closed"
  priority     String    // "Baja", "Normal", "Alta", "Urgente"
  department   String?
  topic        String?
  assignedToId Int?
  assignedTo   Agent?    @relation("AssignedAgent", fields: [assignedToId], references: [id])
  closedById   Int?
  closedBy     Agent?    @relation("ClosedByAgent", fields: [closedById], references: [id])
  commentCount Int       @default(0)
  hasAttachment Boolean  @default(false)
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
  updatedAt    DateTime  @updatedAt
}
